{
  "name": "dead-air",
  "version": "1.0.0",
  "private": true,
  "description": "DEAD AIR - a photoreal bodycam-style zombie shooter for the browser",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "serve": "npx --yes http-server dist/web -p 8080 -c-1",
    "assets": "python3 tools/fetch_assets.py",
    "icons": "node tools/make_favicon.mjs",
    "perf:gate": "node perf/gate.mjs perf/run-3/report.json --phases heavy",
    "perf:pvs": "node perf/pvs_check.mjs",
    "preview": "npm run build && npm run serve"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "three": "0.186.0"
  },
  "engines": {
    "node": "22.x"
  }
}
